{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "IN IDEAS knowledge base",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "Plans",
        "pages": [
          "plans/decisions",
          "plans/viventoo-content-plan",
          "content/winter-campaign-2026-27",
          "content/zimna-kampan-2026-27"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "MCP infrastructure",
        "pages": [
          "mcp/connection-setup",
          "mcp/graphify-reference",
          "mcp/ghost-reference",
          "mcp/changelog"
        ]
      },
      {
        "group": "Content",
        "pages": [
          "content/viventoo-articles"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "dark-plus"
      }
    }
  },
  "metadata": {
    "timestamp": true
  }
}
